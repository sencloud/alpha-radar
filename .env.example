# Tushare Pro token（https://tushare.pro/user/token）
# 期货分钟线需要 ft_mins 权限；A股分钟线需要 stk_mins 权限。
TUSHARE_TOKEN=your_token_here

# 管理口令：POST /runs/trigger（立即扫描）与 POST /scripts/harvest（立即采集）必须带它
# （请求头 X-Admin-Token / Authorization: Bearer，或网页表单里的「管理口令」）。
# 不配置 = 这两个操作一律拒绝（fail closed）。生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
ALPHARADAR_ADMIN_TOKEN=

# 可选：/api/falsification 的缓存秒数与自动条目上限
# ALPHARADAR_FALSIFY_TTL=300
# ALPHARADAR_FALSIFY_LIMIT=2000

# 可选：数据缓存目录与报告目录
# ALPHARADAR_CACHE=./data_cache
# ALPHARADAR_REPORTS=./reports
